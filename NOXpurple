local function targetPart(target)
    if not target or not target.Character then return nil end
    if State.combat.bone == 1 then return target.Character:FindFirstChild("Head") end
    if State.combat.bone == 2 then return target.Character:FindFirstChild("Torso") or target.Character:FindFirstChild("HumanoidRootPart") end
    return target.Character:FindFirstChild("HumanoidRootPart")
end

local function lockTarget()
    local cam = Camera
    if not cam then return nil end
    local sortMode = State.combat.targetSort or 1
    local best = nil
    local bestAng = math.rad(State.combat.fov) / 2
    local bestDist = 1e9
    local bestHp = 1e9
    local selfChar = Char
    for _, pl in pairs(Players:GetPlayers()) do
        if pl == LP or not pl.Character then continue end
        local hum = pl.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            if State.combat.team and pl.Team and LP.Team and pl.Team == LP.Team then continue end
            local part = targetPart(pl)
            if part then
                local dir = (part.Position - cam.CFrame.Position).Unit
                local ang = math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir), -1, 1))
                if ang <= bestAng then
                    if State.combat.visible then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = { selfChar, pl.Character }
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        local hit = Workspace:Raycast(cam.CFrame.Position, dir * 300, rayParams)
                        if hit then continue end
                    end
                    local dist = (part.Position - cam.CFrame.Position).Magnitude
                    if sortMode == 2 then
                        if dist < bestDist then bestDist = dist; best = part end
                    elseif sortMode == 3 then
                        if hum.Health < bestHp then bestHp = hum.Health; best = part end
                    else
                        bestAng = ang
                        best = part
                    end
                end
            end
        end
    end
    return best
end

local resHist = {}
pcall(function()
    Players.PlayerRemoving:Connect(function(pl) resHist[pl] = nil end)
end)
local function resolverTick()
    if not (State.hvh and State.hvh.resolver) then return end
    local w = math.clamp(State.hvh.resWindow or 5, 2, 12)
    for _, pl in pairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local _, y, _ = hrp.CFrame:ToEulerAnglesYXZ()
                local h = resHist[pl]
                if not h then h = { last = y, acc = 0, n = 0, spin = false } resHist[pl] = h end
                local d = math.abs(y - h.last)
                if d > math.pi then d = 2 * math.pi - d end
                h.last = y
                h.acc = h.acc + d
                h.n = h.n + 1
                if h.n >= w then
                    h.spin = (h.acc / h.n) > 0.25
                    h.acc = 0
                    h.n = 0
                end
            end
        end
    end
end
local function resolveAimPoint(part)
    local p = part.Position
    local mdl = part:FindFirstAncestorOfClass("Model")
    local pl = mdl and Players:GetPlayerFromCharacter(mdl) or nil
    local v = part.AssemblyLinearVelocity or part.Velocity
    if pl and resHist[pl] and resHist[pl].spin then
        p = p + Vector3.new(v.X, 0, v.Z) * 0.12 + Vector3.new(0, -0.5, 0)
    else
        p = p + Vector3.new(v.X, 0, v.Z) * 0.03
    end
    return p
end

