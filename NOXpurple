local function findBackdoors()
    task.spawn(function()
        local found = 0
        local function rep(tag, info)
            found = found + 1
            if found <= 60 then logSpy(nil, "BACKDOOR", { tag .. " " .. tostring(info) }) end
        end
        local nilsOK, nils = pcall(function() return getnilinstances() end)
        if nilsOK and type(nils) == "table" then
            for _, o in ipairs(nils) do
                local okR = pcall(function() return o:IsA("RemoteEvent") or o:IsA("RemoteFunction") end)
                if okR then
                    local okp, p = pcall(function() return o:GetFullName() end)
                    rep("nil-remote", (okp and p or o.Name) .. " [" .. o.ClassName .. "]")
                else
                    local okS = pcall(function() return o:IsA("ModuleScript") or o:IsA("Script") or o:IsA("LocalScript") end)
                    if okS then
                        local nm = string.lower(o.Name or "")
                        if nm:find("require") or nm:find("backdoor") or nm:find("admin") or nm:find("hd") then
                            rep("nil-script", o.Name .. " [" .. o.ClassName .. "]")
                        end
                    end
                end
                if found > 60 then break end
            end
        else
            rep("info", "getnilinstances missing")
        end
        local gcOK, gc = pcall(function() return getgc(true) end)
        if gcOK and type(gc) == "table" then
            for _, f in ipairs(gc) do
                if type(f) == "function" then
                    local cOK, consts = pcall(function() return getconstants(f) end)
                    if cOK and type(consts) == "table" then
                        local hasReq, hasNum, c0 = false, false, ""
                        for _, c in ipairs(consts) do
                            if c == "require" then hasReq = true end
                            if type(c) == "number" and c > 100000 then hasNum = true; c0 = tostring(c) end
                        end
                        if hasReq and hasNum then
                            local src = "?"
                            pcall(function()
                                if debug and debug.getinfo then
                                    local inf = debug.getinfo(f, "nS")
                                    if inf then src = tostring(inf.name or inf.short_src or "?") end
                                elseif getinfo then
                                    local inf = getinfo(f)
                                    if inf then src = tostring(inf.name or inf.short_src or inf.source or "?") end
                                end
                            end)
                            rep("require-id", c0 .. " " .. src)
                        end
                    end
                    if found > 60 then break end
                end
            end
        else
            rep("info", "getgc missing")
        end
        bpLog("backdoor scan done: " .. found)
    end)
end

