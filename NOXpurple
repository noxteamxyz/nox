    pill.Position = UDim2.new(1, -70, 0.5, -13)
    pill.BackgroundColor3 = default and Theme.accent or Color3.fromRGB(40, 36, 56)
    pill.BorderSizePixel = 0
    pill.Parent = f
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)
    local k = Instance.new("Frame")
    k.Size = UDim2.new(0, 20, 0, 20)
    k.Position = default and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    k.BackgroundColor3 = Color3.new(1, 1, 1)
    k.BorderSizePixel = 0
    k.Parent = pill
    Instance.new("UICorner", k).CornerRadius = UDim.new(1, 0)
    local pstrokes = glowDeco(pill, Theme.accent, 0.5)
    local on = default
    local function paint(v)
        tween(pill, { BackgroundColor3 = v and Theme.accent or Color3.fromRGB(40, 36, 56) }, 0.2)
        tween(k, { Position = v and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 3, 0.5, -10) }, 0.2, Enum.EasingStyle.Back)
        for _, s in ipairs(pstrokes) do s.Color = v and Theme.accentBright or Theme.accent end
    end
    bindClick(f, function()
        on = not on
        paint(on)
        pcall(onChange, on)
    end)
    paint(default)
    return { Set = function(v) on = v; paint(v); pcall(onChange, v) end, Get = function() return on end }
end

