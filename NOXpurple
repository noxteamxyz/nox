espDraws = {}

local function getDraw(key, kind)
    local d = espDraws[key]
    if d then return d end
    local ok, nd = pcall(function()
        local o = Drawing.new(kind)
        o.Visible = false
        o.Color = Color3.new(1, 1, 1)
        o.Thickness = 1
        return o
    end)
    if ok and nd then espDraws[key] = nd return nd end
    return nil
end

local function renderESP()
    local cam = Camera
    if not cam or cam == nil then return end
    local vs = cam.ViewportSize
    if not vs then return end
    local activeKeys = {}
    for _, pl in pairs(Players:GetPlayers()) do
        if pl == LP or not pl.Character then continue end
        local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
        local hum = pl.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or (hum and hum.Health <= 0) then continue end
        local pos = hrp.Position
        local dist = (cam.CFrame.Position - pos).Magnitude
        if dist > State.visual.distance then continue end
        local base = pl.Name

        if State.visual.chams then
            local hl = pl.Character:FindFirstChildOfClass("Highlight")
            if not hl then
                hl = Instance.new("Highlight")
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = pl.Character
            end
            hl.FillColor = Theme.accent
            hl.FillTransparency = 0.55
            hl.OutlineColor = Theme.accentBright
            hl.OutlineTransparency = 0
        end

        local sTop, onS = cam:WorldToViewportPoint(pos + Vector3.new(0, 3.2, 0))
        local sBot, onB = cam:WorldToViewportPoint(pos - Vector3.new(0, 2.4, 0))
        local toP = pos - cam.CFrame.Position
        if cam.CFrame.LookVector:Dot(toP) <= 0 then continue end
        if not onS or not onB then continue end
        local h = math.abs(sTop.Y - sBot.Y)
        local w = h * 0.55
        local x = sTop.X - w / 2
        local y = math.min(sTop.Y, sBot.Y)
        local col = pl.Team and LP.Team and pl.Team == LP.Team and Color3.fromRGB(80, 255, 160) or Theme.accentBright

        if State.visual.esp then
            local top = getDraw(base .. "_top", "Line")
            local bot = getDraw(base .. "_bot", "Line")
            local l = getDraw(base .. "_l", "Line")
            local r = getDraw(base .. "_r", "Line")
            local hpBg = getDraw(base .. "_hpb", "Line")
            local hp = getDraw(base .. "_hp", "Line")
            local nm = getDraw(base .. "_name", "Text")
            if top then top.From = Vector2.new(x, y); top.To = Vector2.new(x + w, y); top.Color = col; top.Thickness = 1.2; top.Visible = true; activeKeys[base .. "_top"] = true end
            if bot then bot.From = Vector2.new(x, y + h); bot.To = Vector2.new(x + w, y + h); bot.Color = col; bot.Thickness = 1.2; bot.Visible = true; activeKeys[base .. "_bot"] = true end
            if l then l.From = Vector2.new(x, y); l.To = Vector2.new(x, y + h); l.Color = col; l.Thickness = 1.2; l.Visible = true; activeKeys[base .. "_l"] = true end
            if r then r.From = Vector2.new(x + w, y); r.To = Vector2.new(x + w, y + h); r.Color = col; r.Thickness = 1.2; r.Visible = true; activeKeys[base .. "_r"] = true end
            local pct = hum and math.clamp(hum.Health / hum.MaxHealth, 0, 1) or 0
            if hpBg and State.visual.espHp ~= false then hpBg.From = Vector2.new(x - 5, y); hpBg.To = Vector2.new(x - 5, y + h); hpBg.Color = Color3.fromRGB(25, 20, 32); hpBg.Thickness = 3; hpBg.Visible = true; activeKeys[base .. "_hpb"] = true end
            if hp and State.visual.espHp ~= false then hp.From = Vector2.new(x - 5, y + h); hp.To = Vector2.new(x - 5, y + h - h * pct); hp.Color = Color3.fromRGB(80, 255, 120); hp.Thickness = 3; hp.Visible = true; activeKeys[base .. "_hp"] = true end
            if nm then
                if h >= 36 and State.visual.espName ~= false then
                    nm.Position = Vector2.new(x + w / 2, y - 14)
                    nm.Text = pl.Name .. "  " .. math.floor(dist) .. "m"
                    nm.Color = col
                    nm.Size = math.clamp(math.floor(h / 10), 9, 13)
                    nm.Center = true
                    nm.Outline = true
                    nm.Visible = true
                    activeKeys[base .. "_name"] = true
                end
            end
        end

        if State.visual.tracer then
            local tr = getDraw(base .. "_tr", "Line")
            if tr then
                local sp, so = cam:WorldToViewportPoint(pos)
                tr.From = Vector2.new(vs.X / 2, vs.Y)
                tr.To = Vector2.new(sp.X, sp.Y)
                tr.Color = Theme.accent
                tr.Thickness = 1
                tr.Visible = so
                activeKeys[base .. "_tr"] = true
            end
        end
    end
    for k, d in pairs(espDraws) do
        if not activeKeys[k] then pcall(function() d.Visible = false end) end
    end
end

