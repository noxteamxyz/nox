local acNames = { "anticheat", "anti-cheat", "exploit", "detection", "flag", "cheat", "report", "screenshot", "votekick" }
local dmgNames = { "damage", "falldamage", "fall", "hurt", "harm", "kill", "die", "death", "poison", "burn", "lava" }
local ncHooked = false
local idxHooked = false
local newidxHooked = false
local stunHum = nil
local function nameIn(nm, list)
    nm = string.lower(nm or "")
    for _, w in ipairs(list) do
        if nm:find(w, 1, true) then return true end
    end
    return false
end
local function ensureBypassHooks()
    if hookmetamethod and getnamecallmethod and newcclosure and not ncHooked then
        local hOK = pcall(function()
            local oldNC = nil
            oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local m = ""
                pcall(function() m = getnamecallmethod() end)
                if m == "Kick" and (State.bypass.nclock or State.util.antiBan) then
                    bpLog("namecall kick blocked")
                    return nil
                end
                if m == "FireServer" or m == "InvokeServer" then
                    local nm = ""
                    pcall(function() nm = self.Name or "" end)
                    if State.bypass.nclock and (nameIn(nm, acNames) or (State.util.antiBan and nameIn(nm, { "kick", "ban" }))) then
                        bpLog("ac remote blocked: " .. tostring(nm))
                        return nil
                    end
                    if (State.bypass.nodmg or State.bypass.nofall) and nameIn(nm, dmgNames) then
                        bpLog("dmg remote blocked: " .. tostring(nm))
                        return nil
                    end
                end
                return oldNC(self, ...)
            end))
        end)
        ncHooked = hOK
    end
    if hookmetamethod and newcclosure and not idxHooked then
        local hOK = pcall(function()
            local oldIdx = nil
            oldIdx = hookmetamethod(game, "__index", newcclosure(function(self, k)
                if State.bypass.props and type(k) == "string" then
                    if self == Hum then
                        if k == "WalkSpeed" then return 16 end
                        if k == "JumpPower" then return 50 end
                        if k == "JumpHeight" then return 7.2 end
                    elseif self == HRP and HRP then
                        if k == "Velocity" or k == "AssemblyLinearVelocity" then
                            local v = oldIdx(self, k)
                            local mcap = State.bypass.velmax or 120
                            if typeof(v) == "Vector3" and v.Magnitude > mcap then return v.Unit * mcap end
                            return v
                        end
                    end
                end
                return oldIdx(self, k)
            end))
        end)
        idxHooked = hOK
    end
    if hookmetamethod and newcclosure and not newidxHooked then
        local hOK = pcall(function()
            local oldNew = nil
            oldNew = hookmetamethod(game, "__newindex", newcclosure(function(self, k, v)
                if State.bypass.wlock and self == Hum and type(k) == "string" then
                    local fromExploit = false
                    pcall(function() fromExploit = checkcaller() end)
                    if not fromExploit then
                        if k == "WalkSpeed" or k == "JumpPower" or k == "JumpHeight" then return end
                        if k == "Sit" and v == true then return end
                    end
                end
                return oldNew(self, k, v)
            end))
        end)
        newidxHooked = hOK
    end
    if Hum and stunHum ~= Hum then
        stunHum = Hum
        pcall(function()
            Hum.StateChanged:Connect(function(_, new)
                if Closed then return end
                if State.bypass.nostun and (new == Enum.HumanoidStateType.Ragdoll or new == Enum.HumanoidStateType.FallingDown or new == Enum.HumanoidStateType.Physics) then
                    pcall(function() Hum:ChangeState(Enum.HumanoidStateType.Running) end)
                end
            end)
        end)
    end
end

local homoMap = { a = "а", e = "е", i = "і", o = "о", p = "р", c = "с", x = "х", y = "у", h = "һ", k = "к", m = "м" }
local leetMap = { a = "4", e = "3", i = "1", o = "0", s = "5", t = "7" }
local function applyChatBypass(msg)
    if State.bypass.leet then
        msg = string.gsub(msg, ".", function(c)
            local r = leetMap[string.lower(c)]
            return r or c
        end)
    end
    if State.bypass.chatadv then
        msg = string.gsub(msg, ".", function(c)
            local r = homoMap[string.lower(c)]
            return r or c
        end)
    end
    return msg
end

local openDropClose = nil
local function NP_Dropdown(parent, text, options, default, onSelect)
    local f = card(parent, 50)
    local titleL = label(f, text, 14, 250, Theme.text, 13)
    titleL.Size = UDim2.new(0, 250, 0, 22)
    titleL.Position = UDim2.new(0, 14, 0, 4)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 120, 0, 26)
    btn.Position = UDim2.new(1, -140, 0, 12)
    btn.BackgroundColor3 = Theme.cardHover
    btn.Text = default
    btn.TextColor3 = Theme.text
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    btn.BorderSizePixel = 0
    btn.Parent = f
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    glowDeco(btn, Theme.accent, 0.55)
    local open = false
    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, -28, 0, 0)
    list.Position = UDim2.new(0, 14, 0, 42)
    list.BackgroundColor3 = Theme.cardHover
    list.BorderSizePixel = 0
    list.ZIndex = 20
    list.Visible = false
    list.Parent = f
    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 8)
    local ll = Instance.new("UIListLayout")
    ll.Padding = UDim.new(0, 2)
    ll.Parent = list
    local selected = default
    local function close()
        open = false
        list.Visible = false
        f.ZIndex = 1
        if openDropClose == close then openDropClose = nil end
        tween(f, { Size = UDim2.new(1, -2, 0, 50) }, 0.2)
    end
    for _, opt in ipairs(options) do
        local ob = Instance.new("TextButton")
        ob.Size = UDim2.new(1, -8, 0, 26)
        ob.Position = UDim2.new(0, 4, 0, 0)
        ob.BackgroundColor3 = Theme.accent
        ob.BackgroundTransparency = 1
        ob.Text = opt
        ob.TextColor3 = Theme.text
        ob.TextSize = 12
        ob.Font = Enum.Font.GothamMedium
        ob.BorderSizePixel = 0
        ob.Parent = list
        Instance.new("UICorner", ob).CornerRadius = UDim.new(0, 6)
        ob.MouseEnter:Connect(function() ob.BackgroundTransparency = 0.75 end)
        ob.MouseLeave:Connect(function() ob.BackgroundTransparency = 1 end)
        ob.MouseButton1Click:Connect(function()
            selected = opt
            btn.Text = opt
            close()
            pcall(onSelect, opt)
        end)
    end
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            if openDropClose and openDropClose ~= close then openDropClose() end
            openDropClose = close
            list.Size = UDim2.new(1, -28, 0, #options * 28 + 6)
            list.Visible = true
            f.ZIndex = 50
            tween(f, { Size = UDim2.new(1, -2, 0, #options * 28 + 56) }, 0.25, Enum.EasingStyle.Back)
        else
            close()
        end
    end)
    return { Get = function() return selected end }
end

