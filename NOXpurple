local Spies = {}
local lastRemote = nil
local function spoilArgs(inst, args)
    local name = string.lower(inst and inst.Name or "")
    local out = {}
    local n = 0
    for _, arg in ipairs(args) do
        local keep = true
        if State.util.stripTeam and typeof(arg) == "Instance" and arg:IsA("Team") then keep = false end
        if pcall(function() return arg ~= nil and arg.Health ~= nil end) and State.util.spoil and name:match("damage") then keep = false end
        if keep then n = n + 1; out[n] = arg end
    end
    return out
end

local function hookRemote(inst)
    if not inst then return end
    if not inst:IsA("RemoteEvent") and not inst:IsA("RemoteFunction") then return end
    if Spies[inst] then return end
    Spies[inst] = true
    if inst:IsA("RemoteEvent") then
        local oldFire = inst.FireServer
        if not oldFire then return end
        inst.FireServer = function(self, ...)
            local args = { ... }
            lastRemote = inst
            if State.util.spy or (State.dev and State.dev.autolog) then logSpy(inst, "FireServer", args) end
            if State.util.spoil then args = spoilArgs(inst, args) end
            return oldFire(self, unpack(args))
        end
    else
        local oldInv = inst.InvokeServer
        if not oldInv then return end
        inst.InvokeServer = function(self, ...)
            local args = { ... }
            lastRemote = inst
            if State.util.spy or (State.dev and State.dev.autolog) then logSpy(inst, "InvokeServer", args) end
            if State.util.spoil then args = spoilArgs(inst, args) end
            return oldInv(self, unpack(args))
        end
    end
end

