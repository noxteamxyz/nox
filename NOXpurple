        end
        if State.visual.bright then
            Lighting.Ambient = Color3.new(1, 1, 1)
            Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
            Lighting.Brightness = 2
            Lighting.FogEnd = 100000
        end
        if State.visual.freecam then
            local cam2 = Camera
            if cam2 then
                if not freecamWas then
                    freecamWas = true
                    freecamCF = cam2.CFrame
                    freecamPos = freecamCF.Position
                    local _, y, _ = freecamCF:ToEulerAnglesYXZ()
                    freecamYaw = y
                    freecamPitch = 0
                    pcall(function() cam2.CameraType = Enum.CameraType.Scriptable end)
                    pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition end)
                    pcall(function()
                        if HRP then freecamOrigAnchored = HRP.Anchored; HRP.Anchored = true end
                        if Hum then freecamOrigWalk = Hum.WalkSpeed; freecamOrigJump = Hum.JumpPower; Hum.WalkSpeed = 0; Hum.JumpPower = 0; Hum.AutoRotate = false end
                    end)
                end
                pcall(function()
                    if HRP then HRP.Anchored = true; pcall(function() HRP.AssemblyLinearVelocity = Vector3.new(0,0,0) end); HRP.Velocity = Vector3.new(0,0,0) end
                    if Hum then Hum.AutoRotate = false end
                end)
                local sens = State.visual.fcSens or 0.35
                local dt = fc_dt or 0.016
                dt = math.clamp(dt, 0.001, 0.05)
                local move = Vector3.new(0, 0, 0)
                local cf = freecamCF or cam2.CFrame
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, 1, 0) end
                local spd = State.visual.fcSpeed or 60
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then spd = spd * 3 end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then spd = spd * 0.35 end
                if move.Magnitude > 0.001 then
                    freecamPos = freecamPos + move.Unit * spd * dt
                end
                local d = UserInputService:GetMouseDelta()
                if d.X ~= 0 or d.Y ~= 0 then
                    freecamYaw = freecamYaw - d.X * 0.0035 * (sens / 0.35)
                    freecamPitch = math.clamp(freecamPitch - d.Y * 0.0035 * (sens / 0.35), -1.45, 1.45)
                end
                freecamCF = CFrame.new(freecamPos) * CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
                cam2.CFrame = freecamCF
                cam2.Focus = freecamCF + freecamCF.LookVector * 5
            end
        elseif freecamWas then
            freecamWas = false
            freecamCF = nil
            freecamPos = nil
            pcall(function()
                local cam3 = Camera
                if cam3 then
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                    cam3.CameraType = Enum.CameraType.Custom
                    if Hum then cam3.CameraSubject = Hum end
                end
                if HRP and freecamOrigAnchored ~= nil then HRP.Anchored = freecamOrigAnchored end
                if Hum then
                    if freecamOrigWalk then Hum.WalkSpeed = freecamOrigWalk end
                    if freecamOrigJump then Hum.JumpPower = freecamOrigJump end
                    Hum.AutoRotate = true
                end
            end)
            freecamOrigAnchored = nil
            freecamOrigWalk = nil
            freecamOrigJump = nil
        end
        if State.visual.nofog then
            pcall(function() Lighting.FogEnd = 999999 end)
        end
    end)
end)

