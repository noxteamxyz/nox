local activeDrag = nil

local function bindClick(obj, cb)
    local down = false
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            down = true
        end
    end)
    obj.InputEnded:Connect(function(input)
        if down and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            down = false
            pcall(cb)
        end
    end)
end

local hoveredCard = nil
local function hoverKill(e)
    for _, t in ipairs(e.tw) do pcall(function() t:Cancel() end) end
    e.tw = {}
end
local function hoverOff(e)
    hoverKill(e)
    e.tw[1] = tween(e.f, { BackgroundColor3 = e.base }, 0.15)
    for i, s in ipairs(e.strokes) do
        e.tw[i + 1] = tween(s, { Color = Theme.accent, Transparency = e.baseT[i] }, 0.18)
    end
end
local function hoverOn(e)
    if hoveredCard and hoveredCard ~= e then hoverOff(hoveredCard) end
    hoveredCard = e
    hoverKill(e)
    e.tw[1] = tween(e.f, { BackgroundColor3 = Theme.cardHover }, 0.15)
    for i, s in ipairs(e.strokes) do
        e.tw[i + 1] = tween(s, { Color = Theme.accentBright, Transparency = e.baseT[i] - 0.12 }, 0.18)
    end
end
local function card(parent, h)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -2, 0, h or 44)
    f.BackgroundColor3 = Theme.card
    f.BackgroundTransparency = 0.08
    f.BorderSizePixel = 0
    f.LayoutOrder = 0
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
    local strokes = glowDeco(f, Theme.accent, 0.55)
    local baseColor = f.BackgroundColor3
    local entry = { f = f, strokes = strokes, base = baseColor, baseT = {}, tw = {} }
    for i, s in ipairs(strokes) do entry.baseT[i] = s.Transparency end
    f.MouseEnter:Connect(function() hoverOn(entry) end)
    f.MouseLeave:Connect(function()
        if hoveredCard == entry then hoverOff(entry); hoveredCard = nil end
    end)
    return f, strokes
end
pcall(function()
    if Main then
        Main.MouseLeave:Connect(function()
