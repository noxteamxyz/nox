local spyLines = 0
local function logSpy(inst, method, args)
    local flt = State and State.dev and State.dev.filter or ""
    if flt ~= "" and inst then
        local nm = string.lower(tostring(inst.Name) .. " " .. tostring(inst.ClassName))
        local okp, path = pcall(function() return inst:GetFullName() end)
        if okp and path then nm = nm .. " " .. string.lower(path) end
        if not string.find(nm, string.lower(flt), 1, true) then return end
    end
    if State.dev and State.dev.logTarget == 2 then
        pcall(function()
            local an = {}
            for i, a in ipairs(args or {}) do an[i] = string.sub(tostring(a), 1, 50) end
            local nm = inst and inst.Name or "SYS"
            print("[NOX-DEV] " .. tostring(method) .. " " .. tostring(nm) .. " (" .. #an .. " args) " .. table.concat(an, " | "))
        end)
        return
    end
    spyLines = spyLines + 1
    if spyLines > 80 then
        local kids = SpyScroll:GetChildren()
        for _, c in ipairs(kids) do
            if c:IsA("TextLabel") then c:Destroy(); spyLines = spyLines - 1 break end
        end
    end
    local line = Instance.new("TextLabel")
    line.Size = UDim2.new(1, -4, 0, 18)
    line.BackgroundTransparency = 1
    line.Text = method .. "  " .. tostring(inst and inst.Name or "?")
    line.TextColor3 = Theme.subtext
    line.TextSize = 11
    line.Font = Enum.Font.Code
    line.TextXAlignment = Enum.TextXAlignment.Left
    line.Parent = SpyScroll
    for i, a in ipairs(args) do
        local d = ""
        pcall(function() d = string.sub(tostring(a), 1, 60) end)
        local dl = Instance.new("TextLabel")
        dl.Size = UDim2.new(1, -4, 0, 16)
        dl.BackgroundTransparency = 1
        dl.Text = "     [" .. i .. "] " .. d
        dl.TextColor3 = Theme.text
        dl.TextSize = 11
        dl.Font = Enum.Font.Code
        dl.TextXAlignment = Enum.TextXAlignment.Left
        dl.Parent = SpyScroll
    end
end

