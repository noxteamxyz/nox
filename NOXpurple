local function makeScroll()
    local sf = Instance.new("ScrollingFrame")
    sf.Size = UDim2.new(1, 0, 1, 0)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel = 0
    sf.ScrollBarThickness = 3
    sf.ScrollBarImageColor3 = Theme.accent
    sf.CanvasSize = UDim2.new(0, 0, 0, 0)
    sf.Parent = Body
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 14)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.Parent = sf
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = sf
    local autoOK = pcall(function() sf.AutomaticCanvasSize = Enum.AutomaticSize.Y end)
    local function updateCanvas()
        if autoOK then return end
        local ok, cs = pcall(function() return layout.AbsoluteContentSize end)
        if ok and cs and cs.Y > 0 then
            sf.CanvasSize = UDim2.new(0, 0, 0, cs.Y + 24)
            return
        end
        local total = 26
        for _, c in ipairs(sf:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextButton") then
                local okh, hh = pcall(function() return c.Size.Y.Offset end)
                if okh then total = total + hh + 8 end
            end
        end
        sf.CanvasSize = UDim2.new(0, 0, 0, total)
    end
    pcall(function() layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas) end)
    pcall(function() layout.Changed:Connect(updateCanvas) end)
    pcall(function() sf.ChildAdded:Connect(updateCanvas) end)
    pcall(function() RunService.Heartbeat:Connect(updateCanvas) end)
    updateCanvas()
    return sf
end

