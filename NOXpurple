local function glowDeco(f, color, opacity)
    local strokes = {}
    pcall(function()
        local s1 = Instance.new("UIStroke")
        s1.Thickness = 1; s1.Color = color; s1.Transparency = opacity - 0.25
        s1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s1.Parent = f
        strokes[#strokes + 1] = s1
        local s2 = Instance.new("UIStroke")
        s2.Thickness = 3; s2.Color = color; s2.Transparency = opacity + 0.15
        s2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s2.Parent = f
        strokes[#strokes + 1] = s2
        local s3 = Instance.new("UIStroke")
        s3.Thickness = 7; s3.Color = color; s3.Transparency = opacity + 0.35
        s3.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s3.Parent = f
        strokes[#strokes + 1] = s3
    end)
    return strokes
end

